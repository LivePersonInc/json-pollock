{
  "name": "json-pollock",
  "version": "2.4.2",
  "description": "Renders live DOM elements out of JSON according to the Structured Messaging Templates spec",
  "repository": "https://gitlab.com/l1905/conversational-cloud-engineering/communication-channels/web/json-pollock.git",
  "main": "src/index.js",
  "scripts": {
    "build:full": "rspack build --env BUILD_MODE=full VALIDATION=true",
    "build:lib": "rspack build --env BUILD_MODE=bundle VALIDATION=true",
    "build:global": "rspack build --env BUILD_MODE=global VALIDATION=true",
    "build:lib:no_validation": "rspack build  --entry src/index.no_validation.js --env BUILD_MODE=bundle VALIDATION=false",
    "build:global:no_validation": "rspack build --entry src/index.no_validation.js  --env BUILD_MODE=global VALIDATION=false",
    "build": "yarn build:full && yarn build:lib && yarn build:global && yarn build:lib:no_validation && yarn build:global:no_validation",
    "build:docs": "rspress build",
    "dev": "rspress",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "jest --reporters=default --reporters=summary --reporters=jest-junit --coverage --coverageReporters=cobertura --coverageReporters=lcov",
    "test:watch": "jest --watchAll",
    "docs:dev": "rspress",
    "docs:preview": "rspress preview"
  },
  "keywords": [
    "JsonPollock",
    "json-pollock"
  ],
  "author": {
    "name": "liveperson.com",
    "email": "agents-lp@liveperson.com"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "=7",
    "dompurify": "3.2.6",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@eslint/js": "^9.12.0",
    "@jest/globals": "^29.7.0",
    "@rsbuild/plugin-check-syntax": "1.3.0",
    "@rsdoctor/rspack-plugin": "^1.1.7",
    "@rspack/cli": "^1.3.2",
    "@rspack/core": "^1.3.2",
    "@rspress/plugin-playground": "^1.43.2",
    "@testing-library/jest-dom": "^6.6.3",
    "babel-jest": "^29.7.0",
    "babel-polyfill": "^6.26.0",
    "content-replace-webpack-plugin": "^1.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "expect": "^29.6.2",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-extended": "^4.0.2",
    "jest-junit": "^16.0.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "notistack": "^3.0.2",
    "prettier": "^3.3.3",
    "rspress": "^1.43.2",
    "sass-embedded": "^1.85.0",
    "sass-loader": "^16.0.2",
    "style-loader": "^4.0.0",
    "typescript": "^5",
    "url": "^0.11.4",
    "webpack-stats-plugin": "^1.1.3"
  },
  "engines": {
    "node": ">=18",
    "yarn": ">=1.19"
  }
}
